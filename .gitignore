# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/

# Mac OS
.DS_Store

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local databases & logs
*.db
*.sqlite3
*.log

# Streamlit local user credentials
.streamlit/credentials.toml

# Project Generated Artifacts & Large Datasets
# Note: Keep directory structure with .gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/*.db

# Streamlit runtime
.streamlit/secrets.toml
